<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Auto Backup or device-to-device transfer: keys, history and audio stay local
     (CONTRACT 3 and 7.2). allowBackup=false alone does not block device transfer on target 31+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
